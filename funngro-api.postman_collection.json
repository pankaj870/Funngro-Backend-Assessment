{
  "info": {
    "name": "Funngro Backend Assessment API",
    "description": "Postman Collection (v2.1) for Part 1 (Safe Wallet Withdrawals & Paginated Ledger) and Part 2 (Reward Points Conversion & Monthly Finance Report). Run `npm run seed` before testing with the default userId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "660000000000000000000001"
    },
    {
      "key": "withdrawIdempotencyKey",
      "value": "wd_postman_test_0001"
    },
    {
      "key": "convertIdempotencyKey",
      "value": "conv_postman_test_0001"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Part 1 - Wallet & Payouts",
      "item": [
        {
          "name": "Withdraw - Happy Path (₹500 = 50000 paise)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{withdrawIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "withdraw"]
            }
          }
        },
        {
          "name": "Withdraw - Idempotent Retry (Same Key & Amount -> Replays Same Withdrawal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{withdrawIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "withdraw"]
            }
          }
        },
        {
          "name": "Withdraw - Idempotency Conflict (Same Key, Different Amount -> 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{withdrawIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 60000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "withdraw"]
            }
          }
        },
        {
          "name": "Withdraw - Negative Amount Exploit Blocked (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "wd_neg_attack_0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": -50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "withdraw"]
            }
          }
        },
        {
          "name": "Withdraw - Unauthenticated Request Blocked (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "wd_unauth_0001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "withdraw"]
            }
          }
        },
        {
          "name": "Get Paginated Wallet Ledger (Indexed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Auth-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/ledger?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "ledger"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "before", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Part 2 - Reward Points & Monthly Finance Report",
      "item": [
        {
          "name": "Convert Reward Points to Cash (400 pts -> ₹100)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{convertIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pointsToConvert\": 400\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rewards/convert",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rewards", "convert"]
            }
          }
        },
        {
          "name": "Convert Points - Idempotent Retry (Replays Same Conversion)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Auth-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{convertIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pointsToConvert\": 400\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rewards/convert",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rewards", "convert"]
            }
          }
        },
        {
          "name": "Monthly Finance Points Report (Nov 2026, IST)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/finance/points-report?year=2026&month=11&tzOffsetMinutes=330",
              "host": ["{{baseUrl}}"],
              "path": ["api", "finance", "points-report"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "11" },
                { "key": "tzOffsetMinutes", "value": "330" }
              ]
            }
          }
        }
      ]
    }
  ]
}
